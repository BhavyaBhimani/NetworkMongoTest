{
  "environment": "pat",
  "version": 1,
  "description": "Pre-Acceptance Testing Protected Environment Policies",
  "rules": [
    {
      "rule_id": "BASE-HTTP-PAT",
      "name": "Core HTTPS Ingress (pat)",
      "target_env": "pat",
      "direction": "ingress",
      "protocol": "TCP",
      "port_range": "443",
      "source_cidr": "10.0.0.0/8",
      "destination_cidr": "10.1.0.0/16",
      "action": "ALLOW",
      "risk_level": "LOW",
      "description": "Standard encrypted web ingress from internal enterprise network"
    },
    {
      "rule_id": "BASE-DNS-PAT",
      "name": "Core DNS Egress (pat)",
      "target_env": "pat",
      "direction": "egress",
      "protocol": "UDP",
      "port_range": "53",
      "source_cidr": "10.1.0.0/16",
      "destination_cidr": "1.1.1.1/32",
      "action": "ALLOW",
      "risk_level": "LOW",
      "description": "Resolver routing for authoritative internal DNS queries"
    },
    {
      "rule_id": "BASE-DNS-PAT",
      "name": "Core DNS Egress (pat)",
      "target_env": "pat",
      "direction": "ingress",
      "protocol": "UDP",
      "port_range": "53",
      "source_cidr": "0.0.0.0/0",
      "destination_cidr": "1.1.1.1/32",
      "action": "ALLOW",
      "risk_level": "HIGH",
      "description": "Resolver routing for authoritative internal DNS queries"
    }

  ]
}
