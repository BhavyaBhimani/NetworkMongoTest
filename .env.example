# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
# If left empty, NetTrace AI will seamlessly use the embedded high-performance MongoDB engine.
MONGODB_URI=
MONGODB_DB_NAME=nettrace_db

# Google Gemini Free API Key (Get free key from https://aistudio.google.com)
# When set, agents use Gemini 1.5 Flash for cognitive reasoning, drift synthesis, and automated remediation.
# If left empty, agents gracefully fall back to deterministic heuristic rules.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Network Simulation Settings
DEFAULT_ENV=dev
ENABLE_CHANGE_STREAMS=true
AUTO_ATTESTATION_SIGNING=true
